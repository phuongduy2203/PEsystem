@{
    ViewData["Title"] = "Bonepile";
}
@{
    Layout = "~/Areas/Bonepile/Views/Shared/_Layout_Bonepile.cshtml";

}
<!-- Header -->
<header>
    <h1>Bonepile After</h1>
</header>
<!-- KPI Cards -->
<div class="kpi-cards row">
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-total smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Bonepile Total</h5>
                <p class="card-text" id="totalCount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-checkOut smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Scrap Has Task</h5>
                <p class="card-text" id="scrapCount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-checkIn smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Scrap Lacks Task</h5>
                <p class="card-text" id="noTaskScrapCount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-waitingScrap smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Waiting Scrap Approval</h5>
                <p class="card-text" id="waitingScrapCount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-repair smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Repair in RE</h5>
                <p class="card-text" id="repairInRECount">N/A</p>
            </div>
        </div>
    </div>
</div>
<div class="kpi-cards row">
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-kanban smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Waiting BGA Approval</h5>
                <p class="card-text" id="waitingBGACount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-kanban smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Approved BGA</h5>
                <p class="card-text" id="approvedBGACount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-info smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Waiting Link</h5>
                <p class="card-text" id="waitingLinkCount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-info smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Can't Repair Process</h5>
                <p class="card-text" id="notRepairProcessCount">N/A</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-lg-1 col-sm-3 col-3">
        <div class="card text-white bg-info smaller-card">
            <div class="card-body smaller-text">
                <h5 class="card-title">Linked</h5>
                <p class="card-text" id="linkedCount">N/A</p>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="parent">
    <!-- Biểu đồ phân bố trạng thái -->
    <div class="div1">
        <h5 class="card-title">Trạng Thái</h5>
        <canvas id="statusDonutChart"></canvas>
    </div>
    <!-- Biểu đồ Aging -->
    <div class="div2">
        <h5 class="card-title">Aging</h5>
        <canvas id="agingPieChart"></canvas>
    </div>

    <div class="div3">
        <h5 class="card-title">Aging Table</h5>
        <table id="productLineAgingTable" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Product Line</th>
                    <th>&lt;45</th>
                    <th>45-89</th>
                    <th>&ge;90</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="productLineAgingTableBody"></tbody>
        </table>
    </div>
    <div class="div4">
        <h5 class="card-title">Aging by Product Line</h5>
        <canvas id="productLineAgingChart"></canvas>
    </div>
</div>

<!-- Modal for aging records -->
<div class="modal fade" id="recordsModal" tabindex="-1" aria-labelledby="recordsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-lg-custom">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="recordsModalLabel">Serial Numbers</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="recordsTable" class="display table table-bordered table-striped datatable-table" style="width:100%">
                    <thead>
                        <tr>
                            <th>SERIAL_NUMBER</th>
                            <th>PRODUCT_LINE</th>
                            <th>MODEL_NAME</th>
                            <th>MO_NUMBER</th>
                            <th>WIP_GROUP(SFC)</th>
                            <th>WIP_GROUP(KANBAN)</th>
                            <th>ERROR_FLAG</th>
                            <th>WORK_FLAG</th>
                            <th>TEST_GROUP</th>
                            <th>TEST_TIME</th>
                            <th>TEST_CODE</th>
                            <th>ERROR_CODE_ITEM</th>
                            <th>ERROR_DESC</th>
                            <th>AGING</th>
                            <th>LOCATION</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bảng sumMaterialsTable -->
<div class="row my-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <table id="sumMaterialsTable" class="display table table-bordered table-striped datatable-table" style="width:100%">
                    <thead>
                        <tr>
                            <th>SERIAL_NUMBER</th>
                            <th>PRODUCT_LINE</th>
                            <th>MODEL_NAME</th>
                            <th>MO_NUMBER</th>
                            <th>WIP_GROUP(SFC)</th>
                            <th>WIP_GROUP(KANBAN)</th>
                            <th>ERROR_FLAG</th>
                            <th>WORK_FLAG</th>
                            <th>TEST_GROUP</th>
                            <th>TEST_TIME</th>
                            <th>TEST_CODE</th>
                            <th>ERROR_CODE_ITEM</th>
                            <th>ERROR_DESC</th>
                            <th>STATUS</th>
                            <th>STATUS_V2</th>
                            <th>AGING</th>
                            <th>AGING_OLD</th>
                            <th>LOCATION</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/areas/bonepile/js/bonepile_after.js?v=@DateTime.Now.Ticks"></script>
}

    <style>
        .smaller-card {
            transform: scale(0.80); /* Reduce card size by 25% */
            margin: 0 -3px; /* Minimize spacing between cards */
        }

        .smaller-text .card-title {
            font-size: 1.5rem; /* Smaller title font size */
        }

        .smaller-text .card-text {
            font-size: 1.5rem; /* Smaller text font size */
        }

        .kpi-cards {
            display: flex;
            flex-wrap: nowrap; /* Keep cards in a single row */
        }

            .kpi-cards .col-md-2,
            .kpi-cards .col-lg-1,
            .kpi-cards .col-sm-3,
            .kpi-cards .col-3 {
                flex: 0 0 20%; /* Divide equally for 8 cards (100% / 8) */
                max-width: 20%; /* Ensure equal width */
                padding: 0; /* Reduce padding for tighter fit */
            }

        /* Định dạng bảng recordsTable */
        #recordsTable th, #recordsTable td {
            width: 120px !important;
            max-width: 120px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #sumMaterialsTable th, #sumMaterialsTable td {
            width: 120px !important;
            max-width: 120px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .custom-tooltip {
            position: absolute;
            background-color: #333;
            color: #fff;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            z-index: 1000;
            display: none;
            max-width: 300px;
            word-wrap: break-word;
        }


        .parent {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            grid-template-rows: repeat(7, 1fr);
            gap: 8px;
        }

        .div1 {
            grid-column: span 4 / span 4;
            grid-row: span 3 / span 3;
        }

        .div2 {
            grid-column: span 2 / span 2;
            grid-row: span 3 / span 3;
            grid-column-start: 5;
        }

        .div3 {
            grid-column: span 2 / span 2;
            grid-row: span 4 / span 4;
            grid-row-start: 4;
        }

        .div4 {
            grid-column: span 4 / span 4;
            grid-row: span 4 / span 4;
            grid-column-start: 3;
            grid-row-start: 4;
        }
    </style>