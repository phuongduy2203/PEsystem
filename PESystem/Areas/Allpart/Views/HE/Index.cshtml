@{
    ViewData["Title"] = "History Error";
    Layout = "~/Areas/Allpart/Views/Shared/layout_allpart.cshtml";
}

<div class="allpart-page">
    <div class="allpart-hero">
        <h1 class="allpart-title">Tra cứu lịch sử lỗi</h1>
        <p class="allpart-subtitle">Nhập Serial Number để xem chi tiết lịch sử lỗi và tải về báo cáo theo định dạng chuẩn.</p>
    </div>

    <div class="allpart-card">
        <div class="row g-4 align-items-end">
            <div class="col-lg-5">
                <label for="serialNumber" class="form-label text-uppercase fw-semibold">Serial Number</label>
                <textarea id="serialNumber" class="form-control" rows="3" placeholder="Nhập SerialNumber (mỗi dòng một giá trị)..."></textarea>
            </div>
            <div class="col-lg-3">
                <label for="type-options" class="form-label text-uppercase fw-semibold">Kiểu tra cứu</label>
                <select id="type-options" class="form-select">
                    <option selected disabled>SELECT TYPE</option>
                    <option value="1">Tra cứu theo SN-SFG</option>
                    <option value="2">Tra cứu theo SN-FG</option>
                </select>
            </div>
            <div class="col-lg-2 d-grid gap-2">
                <button onclick="search()" class="btn btn-nvidia-primary">
                    <i class="fas fa-search me-2"></i>Tìm kiếm
                </button>
            </div>
            <div class="col-lg-2 d-grid gap-2">
                <button onclick="downloadExcel()" class="btn btn-outline-nvidia">
                    <i class="fas fa-file-download me-2"></i>Tải xuống Excel
                </button>
            </div>
        </div>
    </div>

    <div class="allpart-card mt-4">
        <div class="table-responsive">
            <table id="historyDataTable" class="table table-hover align-middle" style="width:100%">
                <thead>
                    <tr>
                        <th>SERIAL_NUMBER</th>
                        <th>KEY_PART_SN</th>
                        <th>MO_NUMBER</th>
                        <th>MODEL_NAME</th>
                        <th>TEST_TIME</th>
                        <th>TEST_GROUP</th>
                        <th>TEST_CODE</th>
                        <th>DATA1</th>
                        <th>REASON_CODE</th>
                    </tr>
                </thead>
                <tbody id="historyDataTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .allpart-page {
            background: linear-gradient(135deg, rgba(118, 185, 0, 0.1), rgba(118, 185, 0, 0.05));
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .allpart-hero {
            text-align: center;
            margin-bottom: 2rem;
        }

        .allpart-title {
            font-size: 2rem;
            font-weight: 700;
            color: #0f1f08;
        }

        .allpart-subtitle {
            max-width: 720px;
            margin: 0 auto;
            color: #314321;
        }

        .allpart-card {
            background: #fff;
            border-radius: 20px;
            padding: 1.75rem;
            border: 1px solid rgba(118, 185, 0, 0.2);
            box-shadow: 0 15px 30px rgba(15, 31, 8, 0.08);
        }

        .btn-nvidia-primary {
            background: linear-gradient(135deg, #76B900, #4E8C00);
            color: #fff;
            font-weight: 600;
            border: none;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .btn-nvidia-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 24px rgba(118, 185, 0, 0.35);
            }

        .btn-outline-nvidia {
            border: 2px solid #76B900;
            color: #1A2E05;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            .btn-outline-nvidia:hover {
                background: #76B900;
                color: #fff;
            }

        .custom-tooltip {
            position: absolute;
            background-color: rgba(25, 39, 13, 0.92);
            color: #fff;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            z-index: 1000;
            display: none;
            max-width: 260px;
            word-wrap: break-word;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
        }

        .table thead th {
            background-color: #76B900;
            color: #fff;
            border: none;
            text-transform: uppercase;
            font-weight: 700;
        }

        .table tbody tr:hover {
            background-color: rgba(118, 185, 0, 0.1);
        }

        .form-select:focus, .form-control:focus {
            border-color: #76B900;
            box-shadow: 0 0 0 0.2rem rgba(118, 185, 0, 0.25);
        }

        textarea.form-control {
            resize: vertical;
        }

        @media (max-width: 991.98px) {
            .allpart-page {
                padding: 1.5rem;
            }

            .allpart-card {
                padding: 1.5rem;
            }
        }
    </style>

    <script>
        let tableData = []; // Lưu dữ liệu để xuất Excel
        let dataTable; // Lưu tham chiếu đến DataTable

        // Hàm tạo nội dung cho ô với tooltip
        function createTooltipCell(data) {
            return `<span class="tooltip-trigger" data-tooltip="${data || ''}">${data || ''}</span>`;
        }

        // Hàm gắn sự kiện tooltip cho các phần tử
        function attachTooltipEvents() {
            $('.tooltip-trigger').each(function () {
                const $this = $(this);
                if (!$this.data('tooltip-initialized')) {
                    $this.on('mouseover', function (e) {
                        const tooltipText = $this.data('tooltip');
                        if (tooltipText) {
                            let tooltip = document.querySelector('.custom-tooltip');
                            if (!tooltip) {
                                tooltip = document.createElement('div');
                                tooltip.className = 'custom-tooltip';
                                document.body.appendChild(tooltip);
                            }
                            tooltip.textContent = tooltipText;
                            tooltip.style.display = 'block';
                            tooltip.style.left = (e.pageX + 10) + 'px';
                            tooltip.style.top = (e.pageY - 20) + 'px';
                        }
                    }).on('mousemove', function (e) {
                        const tooltip = document.querySelector('.custom-tooltip');
                        if (tooltip && tooltip.style.display === 'block') {
                            tooltip.style.left = (e.pageX + 10) + 'px';
                            tooltip.style.top = (e.pageY - 20) + 'px';
                        }
                    }).on('mouseout', function () {
                        const tooltip = document.querySelector('.custom-tooltip');
                        if (tooltip) {
                            tooltip.style.display = 'none';
                        }
                    });
                    $this.data('tooltip-initialized', true);
                }
            });
        }

        function downloadExcel() {
            if (tableData.length === 0) {
                Swal.fire("Thông báo", "Không có dữ liệu để tải xuống!", "warning");
                return;
            }

            const worksheet = XLSX.utils.json_to_sheet(tableData);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "HistoryError");

            const now = new Date();
            const formattedDate = now.toISOString().slice(0, 19).replace(/[:T]/g, "-");
            const filename = `HistoryError_${formattedDate}.xlsx`;
            XLSX.writeFile(workbook, filename);
        }

        async function search() {
            const serialNumbers = $("#serialNumber").val().trim();
            const type = $("#type-options").val();

            if (!serialNumbers) {
                Swal.fire("Thông báo", "Vui lòng nhập Serial Number!", "warning");
                return;
            }

            if (!type) {
                Swal.fire("Thông báo", "Vui lòng chọn kiểu tra cứu!", "warning");
                return;
            }

            const requestData = {
                serialNumber: serialNumbers,
                type: parseInt(type)
            };

            try {
                Swal.fire({
                    title: "Đang tải dữ liệu...",
                    didOpen: () => Swal.showLoading(),
                    allowOutsideClick: false,
                    showConfirmButton: false
                });

                const response = await fetch("http://10.220.130.119:9090/api/HistoryError/get-data", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(requestData)
                });

                if (!response.ok) {
                    throw new Error("API trả về lỗi: " + response.status);
                }

                const result = await response.json();
                Swal.close();

                if (!result.success || !result.data || result.data.length === 0) {
                    Swal.fire("Không có dữ liệu!", "Không tìm thấy dữ liệu lịch sử lỗi cho Serial Number đã nhập", "info");
                    if (dataTable) {
                        dataTable.clear().draw();
                    }
                    tableData = [];
                    return;
                }

                tableData = result.data;

                if (dataTable) {
                    dataTable.destroy();
                }

                const tableBody = document.getElementById("historyDataTableBody");
                tableBody.innerHTML = "";

                result.data.forEach(item => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td>${createTooltipCell(item.serialNumber)}</td>
                        <td>${createTooltipCell(item.keyPartSn)}</td>
                        <td>${createTooltipCell(item.moNumber)}</td>
                        <td>${createTooltipCell(item.modelName)}</td>
                        <td>${createTooltipCell(item.testTime)}</td>
                        <td>${createTooltipCell(item.testGroup)}</td>
                        <td>${createTooltipCell(item.testCode)}</td>
                        <td>${createTooltipCell(item.data1)}</td>
                        <td>${createTooltipCell(item.reasonCode)}</td>
                    `;
                    tableBody.appendChild(row);
                });

                dataTable = $("#historyDataTable").DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    language: {
                        search: "Tìm kiếm:",
                        lengthMenu: "Hiển thị _MENU_ dòng mỗi trang",
                        info: "Hiển thị _START_ đến _END_ của _TOTAL_ dòng",
                        paginate: {
                            first: "Đầu",
                            last: "Cuối",
                            next: "Tiếp",
                            previous: "Trước"
                        }
                    }
                });

                attachTooltipEvents();
            } catch (error) {
                Swal.close();
                console.error(error);
                Swal.fire("Lỗi!", error.message, "error");
            }
        }
    </script>
}
