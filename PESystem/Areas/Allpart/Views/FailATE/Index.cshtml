@{
    ViewData["Title"] = "History Error";
    Layout = "~/Areas/Allpart/Views/Shared/layout_allpart.cshtml";
}

<div class="allpart-page">
    <div class="allpart-hero">
        <h1 class="allpart-title">Fail ATE Tracking</h1>
        <p class="allpart-subtitle">Tra cứu chi tiết lỗi Fail ATE cho từng Serial Number và xuất báo cáo nhanh chóng.</p>
    </div>

    <div class="allpart-card">
        <div class="row g-4 align-items-end">
            <div class="col-lg-6">
                <label for="serialNumber" class="form-label text-uppercase fw-semibold">Serial Number</label>
                <textarea id="serialNumber" class="form-control" rows="2" placeholder="Nhập SerialNumber..."></textarea>
            </div>
            <div class="col-lg-3 d-grid gap-2">
                <button onclick="search()" class="btn btn-nvidia-primary">
                    <i class="fas fa-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </div>
    </div>

    <div class="allpart-card mt-4">
        <div class="table-responsive">
            <table id="historyDataTable" class="table table-hover align-middle" style="width:100%">
                <thead>
                    <tr>
                        <th>SERIAL_NUMBER</th>
                        <th>MODEL_NAME</th>
                        <th>LINE_NAME</th>
                        <th>SECTION_NAME</th>
                        <th>GROUP_NAME</th>
                        <th>STATION_NAME</th>
                        <th>ERROR_CODE</th>
                        <th>ERROR_DESC</th>
                        <th>DATA6</th>
                        <th>DATA12</th>
                        <th>PASS_COUNT</th>
                        <th>RETEST_COUNT</th>
                        <th>TEST_VALUE</th>
                        <th>IN_STATION_TIME</th>
                        <th>RESULT</th>
                        <th>DATA2</th>
                        <th>TEST_MODE</th>
                        <th>SCOF_MIN</th>
                    </tr>
                </thead>
                <tbody id="historyDataTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .allpart-page {
            background: linear-gradient(135deg, rgba(118, 185, 0, 0.1), rgba(118, 185, 0, 0.05));
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .allpart-hero {
            text-align: center;
            margin-bottom: 2rem;
        }

        .allpart-title {
            font-size: 2rem;
            font-weight: 700;
            color: #0f1f08;
        }

        .allpart-subtitle {
            max-width: 720px;
            margin: 0 auto;
            color: #314321;
        }

        .allpart-card {
            background: #fff;
            border-radius: 20px;
            padding: 1.75rem;
            border: 1px solid rgba(118, 185, 0, 0.2);
            box-shadow: 0 15px 30px rgba(15, 31, 8, 0.08);
        }

        .btn-nvidia-primary {
            background: linear-gradient(135deg, #76B900, #4E8C00);
            color: #fff;
            font-weight: 600;
            border: none;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .btn-nvidia-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 24px rgba(118, 185, 0, 0.35);
            }

        .table thead th {
            background-color: #76B900;
            color: #fff;
            border: none;
            text-transform: uppercase;
            font-weight: 700;
        }

        .table tbody tr:hover {
            background-color: rgba(118, 185, 0, 0.1);
        }

        .form-select:focus, .form-control:focus {
            border-color: #76B900;
            box-shadow: 0 0 0 0.2rem rgba(118, 185, 0, 0.25);
        }

        textarea.form-control {
            resize: vertical;
        }

        @media (max-width: 991.98px) {
            .allpart-page {
                padding: 1.5rem;
            }

            .allpart-card {
                padding: 1.5rem;
            }
        }
    </style>

    <script>
        let historyTable = null;

        async function search() {
            const sn = $("#serialNumber").val().trim().toUpperCase();
            if (!sn) {
                Swal.fire("Thông báo", "Vui lòng nhập Serial Number!", "warning");
                return;
            }

            try {
                Swal.fire({
                    title: "Đang tải dữ liệu...",
                    didOpen: () => Swal.showLoading(),
                    allowOutsideClick: false,
                    showConfirmButton: false
                });

                const response = await fetch("http://10.220.130.119:9090/api/CheckInOut/get-fail-ate", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(sn)
                });

                if (!response.ok) {
                    throw new Error("API trả về lỗi: " + response.status);
                }

                const result = await response.json();

                Swal.close();

                if (!result.success || !result.data || result.data.length === 0) {
                    Swal.fire("Không có dữ liệu!", "Không tìm thấy dữ liệu lỗi cho SN: " + sn, "info");
                    if (historyTable) {
                        historyTable.clear().draw();
                    }
                    return;
                }

                renderTable(result.data);
            } catch (err) {
                Swal.close();
                console.error(err);
                Swal.fire("Lỗi!", err.message, "error");
            }
        }

        function renderTable(data) {
            if (historyTable) {
                historyTable.destroy();
            }

            const tbody = document.getElementById("historyDataTableBody");
            tbody.innerHTML = "";

            data.forEach(item => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${item.serialNumber || ''}</td>
                    <td>${item.modelName || ''}</td>
                    <td>${item.lineName || ''}</td>
                    <td>${item.sectionName || ''}</td>
                    <td>${item.groupName || ''}</td>
                    <td>${item.stationName || ''}</td>
                    <td>${item.errorCode || ''}</td>
                    <td>${item.errorDesc || ''}</td>
                    <td>${item.data6 || ''}</td>
                    <td>${item.data12 || ''}</td>
                    <td>${item.passCount || ''}</td>
                    <td>${item.retestCount || ''}</td>
                    <td>${item.testValue || ''}</td>
                    <td>${item.inStationTime || ''}</td>
                    <td>${item.result || ''}</td>
                    <td>${item.data2 || ''}</td>
                    <td>${item.testMode || ''}</td>
                    <td>${item.scofMin || ''}</td>
                `;
                tbody.appendChild(row);
            });

            historyTable = $("#historyDataTable").DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: {
                    search: "Tìm kiếm:",
                    lengthMenu: "Hiển thị _MENU_ dòng mỗi trang",
                    info: "Hiển thị _START_ đến _END_ của _TOTAL_ dòng",
                    paginate: {
                        first: "Đầu",
                        last: "Cuối",
                        next: "Tiếp",
                        previous: "Trước"
                    }
                }
            });
        }
    </script>
}
