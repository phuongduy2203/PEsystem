@{
    ViewData["Title"] = "process can't repair";
    Layout = "~/Areas/Scrap/views/Shared/Layout_scrap.cshtml";
}

<div class="scrap-page">
    <div class="scrap-page-header">
        <h1 class="scrap-title">Process Can't Repair</h1>
        <p class="scrap-subtitle">Quản lý nhanh các bản lỗi process không thể sửa chữa, nhập mới hoặc tải danh sách hiện hữu.</p>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-4">
            <div class="scrap-card selection-card">
                <h2 class="scrap-card-title">Chức năng nhanh</h2>
                <p class="scrap-card-text">Chọn thao tác phù hợp để hiển thị biểu mẫu tương ứng.</p>
                <form id="search-form" class="scrap-selector">
                    <label for="search-options" class="form-label fw-semibold text-uppercase">Danh mục chức năng</label>
                    <select id="search-options" class="form-select">
                        <option selected disabled>SELECT FUNCTION</option>
                        <option value="INPUT_SN_1">INPUT SN</option>
                        <option value="SN_PROCESS_CANT_REPAIR">SN process can't repair</option>
                    </select>
                </form>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="scrap-form-stack">
                <form id="input-sn-1-form" method="post" class="scrap-card scrap-form hidden" data-search-type="INPUT_SN">
                    <div class="scrap-form-header">
                        <h3>Nhập danh sách SN</h3>
                        <p>Điền các bản process lỗi không thể sửa để cập nhật hệ thống.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="sn-input-1" class="form-label">Danh sách Serial Number</label>
                            <textarea name="serialNumbers" id="sn-input-1" class="form-control" rows="8" placeholder="Nhập mỗi SN trên một dòng"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="description-input-1" class="form-label">Mô tả lỗi</label>
                            <input type="text" id="description-input-1" name="description" class="form-control" placeholder="Nhập mô tả chi tiết">
                            <div class="mt-4 text-end">
                                <button id="input-sn-btn" class="btn btn-ne btn-gradient" type="button">
                                    <i class="fas fa-upload me-2"></i>INPUT SN
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <form id="custom-form" method="post" class="scrap-card scrap-form hidden" data-search-type="SN_WAIT_LIST_FORM">
                    <div class="scrap-form-header">
                        <h3>Danh sách đang chờ xử lý</h3>
                        <p>Tải dữ liệu tổng hợp các bản process can't repair.</p>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button id="sn-wait-list-btn" class="btn btn-ne btn-gradient" type="button">
                            <i class="fas fa-file-download me-2"></i>Download Excel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="scrap-results">
        <div id="input-sn-1-result" class="scrap-card scrap-result hidden"></div>

        <div id="sn-wait-approve-result" class="scrap-card scrap-result hidden">
            <div class="table-responsive">
                <table id="table-sn-wait-approve" class="table table-hover align-middle" style="width:100%">
                    <thead>
                        <tr>
                            <th>SERIAL_NUMBER</th>
                            <th>DESCRIPTION</th>
                            <th>CREATE_TIME</th>
                            <th>APPLY_TASK_STATUS</th>
                            <th>CREATE_BY</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .hidden {
            display: none !important;
        }

        .scrap-page {
            background: linear-gradient(135deg, rgba(118, 185, 0, 0.12), rgba(118, 185, 0, 0.05));
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .scrap-page-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .scrap-title {
            font-size: 2rem;
            font-weight: 700;
            color: #1A2E05;
        }

        .scrap-subtitle {
            color: #3f4d2a;
            max-width: 680px;
            margin: 0 auto;
        }

        .scrap-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 1.75rem;
            box-shadow: 0 12px 30px rgba(26, 46, 5, 0.08);
            border: 1px solid rgba(118, 185, 0, 0.18);
        }

        .scrap-card-title {
            font-weight: 700;
            color: #1A2E05;
        }

        .scrap-card-text {
            color: #4f5b39;
            margin-bottom: 1.25rem;
        }

        .scrap-form-header h3 {
            font-weight: 700;
            color: #1A2E05;
        }

        .scrap-form-header p {
            color: #4f5b39;
            margin-bottom: 1.25rem;
        }

        .scrap-form-stack .scrap-card + .scrap-card,
        .scrap-results .scrap-card + .scrap-card {
            margin-top: 1.5rem;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #76B900, #4E8C00);
            border: none;
            color: #fff !important;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .btn-gradient:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 18px rgba(118, 185, 0, 0.35);
            }

        .table thead th {
            background-color: #76B900;
            color: #fff;
            font-weight: 700;
            text-transform: uppercase;
            border: none;
        }

        .table tbody tr:hover {
            background-color: rgba(118, 185, 0, 0.1);
        }

        .form-select:focus, .form-control:focus {
            border-color: #76B900;
            box-shadow: 0 0 0 0.2rem rgba(118, 185, 0, 0.25);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 180px;
        }

        @media (max-width: 991.98px) {
            .scrap-page {
                padding: 1.5rem;
            }

            .scrap-form-stack .scrap-card + .scrap-card {
                margin-top: 1rem;
            }
        }
    </style>
    <script src="~/assets/areas/scrap/js/function0.js?v=@DateTime.Now.Ticks"></script>
}
